---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ProductHero from '../../../components/ProductHero.astro';
import TextSection from '../../../components/TextSection.astro';
import ServiceProcess from '../../../components/ServiceProcess.astro';
import Differentiators from '../../../components/Differentiators.astro';
import TechStackTags from '../../../components/TechStackTags.astro';
import ProductDisclaimer from '../../../components/ProductDisclaimer.astro';
import CtaBand from '../../../components/CtaBand.astro';
import { getHomeContent } from '../../../content/home';
import { getAllProductSlugs, getProductContent } from '../../../content/products';

export function getStaticPaths() {
  return getAllProductSlugs('sv').map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const currentLang = 'sv';
const homeContent = getHomeContent(currentLang);
const product = getProductContent(currentLang, slug!)!;
---

<BaseLayout meta={product.meta} nav={homeContent.nav} footer={homeContent.footer} currentLang={currentLang}>
  <ProductHero
    eyebrow={product.hero.eyebrow}
    title={product.hero.title}
    tagline={product.hero.tagline}
    intro={product.hero.intro}
    statusLabel={product.statusLabel}
  />
  <TextSection heading={product.problem.heading} paragraphs={product.problem.paragraphs} />
  <ServiceProcess process={product.workflow} columns={product.workflow.columns} />
  <Differentiators differentiators={product.safeguards} />
  <TechStackTags techStack={product.techStack} />
  <ProductDisclaimer disclaimer={product.disclaimer} />
  <CtaBand
    heading={product.cta.heading}
    body={product.cta.body}
    primaryLabel={product.cta.primaryLabel}
    primaryHref={product.cta.primaryHref}
    secondaryLabel={product.cta.secondaryLabel}
    secondaryHref={product.cta.secondaryHref}
  />
</BaseLayout>
