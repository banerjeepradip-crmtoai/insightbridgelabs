---
import '../styles/global.css';

const title = 'Pradip Banerjee — Enterprise & Salesforce Solution Architect';
const description =
  'Enterprise Solution Architect · Salesforce Architect · Enterprise AI & AI Governance. Connect with Pradip Banerjee.';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="profile" />
    <meta property="og:image" content="https://www.insightbridgelabs.com/images/pb2.jpg" />
  </head>
  <body>
    <div class="card">
      <div class="hero">
        <svg class="network" viewBox="0 0 440 260" preserveAspectRatio="xMidYMid slice">
          <g stroke="#8b7cf6" stroke-width="1">
            <line x1="20" y1="40" x2="90" y2="90" />
            <line x1="90" y1="90" x2="60" y2="150" />
            <line x1="90" y1="90" x2="170" y2="60" />
            <line x1="350" y1="30" x2="410" y2="80" />
            <line x1="350" y1="30" x2="300" y2="70" />
            <line x1="380" y1="150" x2="420" y2="200" />
            <line x1="380" y1="150" x2="330" y2="190" />
            <line x1="30" y1="200" x2="80" y2="230" />
          </g>
          <g fill="#a99bf7">
            <circle cx="20" cy="40" r="3" />
            <circle cx="90" cy="90" r="3" />
            <circle cx="60" cy="150" r="3" />
            <circle cx="170" cy="60" r="3" />
            <circle cx="350" cy="30" r="3" />
            <circle cx="410" cy="80" r="3" />
            <circle cx="300" cy="70" r="3" />
            <circle cx="380" cy="150" r="3" />
            <circle cx="420" cy="200" r="3" />
            <circle cx="330" cy="190" r="3" />
            <circle cx="30" cy="200" r="3" />
            <circle cx="80" cy="230" r="3" />
          </g>
        </svg>
        <div class="hero-inner">
          <div class="avatar-wrap">
            <img class="avatar" src="/images/pb2.jpg" alt="Pradip Banerjee" width="112" height="112" />
          </div>
          <h1 class="name">Pradip Banerjee</h1>
          <p class="role">Enterprise Solution Architect &middot; Salesforce Architect<br />Enterprise AI &amp; AI Governance</p>
          <p class="pitch">
            Open to <strong>Consulting</strong>, <strong>Advisory</strong>, <strong>Product Collaboration</strong> &amp; <strong>Permanent Architecture Roles</strong>.
          </p>

          <div class="quick-contact">
            <a class="qc-item" href="tel:+46705409044">
              <svg class="qc-ico" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                ><path
                  d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.362 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.338 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"
                ></path></svg
              >
              <span>+46 70 540 90 44</span>
            </a>
            <a class="qc-item" href="mailto:banerjee.pradip@gmail.com">
              <svg class="qc-ico" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                ><rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="m3 7 9 6 9-6"></path></svg
              >
              <span>banerjee.pradip@gmail.com</span>
            </a>
            <a class="qc-item" href="https://www.linkedin.com/in/pradipbanerjee1/">
              <svg class="qc-ico qc-ico-fill" viewBox="0 0 24 24"
                ><path
                  d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
                ></path></svg
              >
              <span>linkedin.com/in/pradipbanerjee1</span>
            </a>
          </div>
        </div>
      </div>

      <div class="body">
        <p class="bio">
          Nearly two decades designing CRM, data and business-critical enterprise systems. Today I design and build
          Enterprise AI — agentic applications, RAG and intelligent workflows — using Salesforce, Agentforce, cloud
          platforms and enterprise data under responsible governance. My work isn't limited to Salesforce: I build
          Salesforce-native AI, integrate Salesforce with external AI platforms, or develop fully independent AI
          applications — whatever gets you from AI idea to secure, production-ready value fastest.
        </p>

        <span class="eyebrow">Currently Building</span>
        <ul class="list">
          <li>
            <span class="ico"
              ><svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                ><path d="M13 2 3 14h8l-1 8 10-12h-8z"></path></svg
              ></span
            >
            Enterprise AI &amp; agentic applications — Salesforce-powered or fully independent
          </li>
          <li>
            <span class="ico"
              ><svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                ><circle cx="12" cy="5" r="2"></circle><circle cx="5" cy="19" r="2"></circle><circle
                  cx="19"
                  cy="19"
                  r="2"></circle><path d="M12 7v6M12 13 6 17M12 13l6 4"></path></svg
              ></span
            >
            RAG solutions grounded in trusted enterprise knowledge
          </li>
          <li>
            <span class="ico"
              ><svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                ><path d="M13 2 3 14h8l-1 8 10-12h-8z"></path></svg
              ></span
            >
            CRM-to-AI decision engines &amp; intelligent business workflows
          </li>
          <li>
            <span class="ico"
              ><svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                ><rect x="3" y="4" width="18" height="16" rx="2"></rect><path d="M3 9h18M8 4v5"></path></svg
              ></span
            >
            Rapid enterprise applications — from requirements to production
          </li>
        </ul>

        <span class="eyebrow">How I Help Companies</span>
        <ul class="list">
          <li>
            <span class="ico"
              ><svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                ><path d="M3 3v18h18"></path><path d="M7 15l4-4 3 3 6-7"></path></svg
              ></span
            >
            Design Enterprise AI architecture — Salesforce-based, integrated or independent
          </li>
          <li>
            <span class="ico"
              ><svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                ><path d="M4 4h16v4H4zM4 10h10v4H4zM4 16h7v4H4z"></path></svg
              ></span
            >
            Architect and modernize Salesforce platforms &amp; integrations
          </li>
          <li>
            <span class="ico"
              ><svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                ><path
                  d="M12 2v4M12 18v4M4.9 4.9l2.8 2.8M16.3 16.3l2.8 2.8M2 12h4M18 12h4M4.9 19.1l2.8-2.8M16.3 7.7l2.8-2.8"
                ></path></svg
              ></span
            >
            Identify and assess high-value enterprise AI use cases
          </li>
          <li>
            <span class="ico"
              ><svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                ><rect x="3" y="11" width="18" height="10" rx="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"
                ></path></svg
              ></span
            >
            Establish responsible AI governance &amp; data-readiness foundations
          </li>
        </ul>

        <div class="divider"></div>
      </div>

      <div class="contact">
        <a
          class="btn btn-primary"
          href="https://calendar.google.com/calendar/u/0/appointments/schedules/AcZssZ2R7zuWj3SA2GY3RFnM4QmjJDyMaXEhWRC2uFuWfpUwYQD6Yau1Ls-LMAxhVLHtQdwu6dsICmRL"
        >
          <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
            ><rect x="3" y="5" width="18" height="16" rx="2"></rect><path d="M16 3v4M8 3v4M3 10h18"></path><path
              d="M9 15l2 2 4-4"
            ></path></svg
          >
          <span class="label">Book a Conversation</span>
          <svg class="arrow" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
            ><path d="M5 12h14M13 6l6 6-6 6"></path></svg
          >
        </a>
        <a class="btn btn-secondary" href="https://www.linkedin.com/in/pradipbanerjee1/">
          <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
            ><rect x="3" y="3" width="18" height="18" rx="2"></rect><path
              d="M7 10v7M7 7v.01M11 17v-4.5a2.5 2.5 0 0 1 5 0V17M11 10.5V17"
            ></path></svg
          >
          <span class="label">Connect on LinkedIn</span>
          <svg class="arrow" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
            ><path d="M5 12h14M13 6l6 6-6 6"></path></svg
          >
        </a>
        <a class="btn btn-secondary" href="mailto:banerjee.pradip@gmail.com">
          <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
            ><rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="m3 7 9 6 9-6"></path></svg
          >
          <span class="label">banerjee.pradip@gmail.com</span>
          <svg class="arrow" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
            ><path d="M5 12h14M13 6l6 6-6 6"></path></svg
          >
        </a>
      </div>

      <div class="footer">
        <p class="tagline">
          Let&rsquo;s explore how Enterprise AI, Salesforce and modern cloud technology can create measurable
          business value for your organization.
        </p>
        <a class="site" href="https://www.insightbridgelabs.com" target="_blank" rel="noopener">insightbridgelabs.com</a>
      </div>
    </div>
  </body>
</html>

<style>
  body {
    background: var(--color-gray-50);
    display: flex;
    justify-content: center;
    padding: 40px 16px 64px;
  }

  .card {
    width: 100%;
    max-width: 440px;
    background: #fff;
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-card);
    border: 1px solid var(--color-gray-200);
  }

  /* ---------- HERO ---------- */
  .hero {
    position: relative;
    background:
      radial-gradient(120% 140% at 20% 0%, rgba(139, 124, 246, 0.55) 0%, rgba(79, 70, 229, 0) 55%),
      linear-gradient(160deg, var(--color-navy-900) 0%, var(--color-navy-950) 100%);
    padding: 40px 28px 32px;
    text-align: center;
    overflow: hidden;
  }

  .hero svg.network {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0.35;
  }

  .hero-inner {
    position: relative;
    z-index: 1;
  }

  .avatar-wrap {
    width: 112px;
    height: 112px;
    margin: 0 auto 20px;
    border-radius: 50%;
    padding: 3px;
    background: var(--color-accent-gradient);
  }

  .avatar {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    object-fit: cover;
    border: 3px solid var(--color-navy-950);
  }

  .name {
    font-size: 1.5rem;
    font-weight: 800;
    letter-spacing: -0.01em;
    color: #fff;
    margin: 0 0 6px;
    text-wrap: balance;
  }

  .role {
    font-size: 0.92rem;
    font-weight: 600;
    color: #c9c4fb;
    line-height: 1.45;
    margin: 0 0 16px;
    text-wrap: balance;
  }

  .pitch {
    font-size: 0.88rem;
    color: rgba(255, 255, 255, 0.72);
    line-height: 1.55;
    margin: 0;
    max-width: 340px;
    margin-inline: auto;
  }

  .pitch strong {
    color: #fff;
    font-weight: 700;
  }

  .quick-contact {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 9px;
    margin-top: 20px;
  }

  .qc-item {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.8rem;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.8);
    text-decoration: none;
  }

  .qc-item:hover {
    color: #fff;
  }

  .qc-ico {
    width: 15px;
    height: 15px;
    flex: 0 0 15px;
    stroke: rgba(255, 255, 255, 0.8);
  }

  .qc-item:hover .qc-ico {
    stroke: #fff;
  }

  .qc-ico-fill {
    fill: rgba(255, 255, 255, 0.8);
    stroke: none;
  }

  .qc-item:hover .qc-ico-fill {
    fill: #fff;
  }

  /* ---------- BODY ---------- */
  .body {
    padding: 28px 28px 8px;
  }

  .bio {
    font-size: 0.92rem;
    line-height: 1.65;
    color: var(--color-gray-600);
    margin: 0 0 28px;
  }

  .eyebrow {
    display: block;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--color-indigo-600);
    margin-bottom: 12px;
  }

  .list {
    list-style: none;
    margin: 0 0 28px;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .list li {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    font-size: 0.88rem;
    line-height: 1.5;
    color: var(--color-gray-900);
  }

  .list .ico {
    flex: 0 0 30px;
    width: 30px;
    height: 30px;
    border-radius: 9px;
    background: var(--color-gray-100);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .list .ico svg {
    width: 16px;
    height: 16px;
    stroke: var(--color-indigo-600);
  }

  .divider {
    height: 1px;
    background: var(--color-gray-200);
    margin: 0 0 28px;
  }

  /* ---------- CONTACT ---------- */
  .contact {
    padding: 4px 28px 28px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .btn {
    display: flex;
    align-items: center;
    gap: 12px;
    width: 100%;
    padding: 14px 16px;
    border-radius: 12px;
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
    border: 1.5px solid transparent;
  }

  .btn svg {
    width: 18px;
    height: 18px;
    flex: 0 0 18px;
  }

  .btn .label {
    flex: 1;
  }

  .btn .arrow {
    flex: 0 0 14px;
    width: 14px;
    height: 14px;
    opacity: 0.6;
  }

  .btn-primary {
    background: var(--color-accent-gradient);
    color: #fff;
  }

  .btn-primary svg {
    stroke: #fff;
  }

  .btn-secondary {
    background: var(--color-gray-100);
    color: var(--color-gray-900);
    border-color: var(--color-gray-200);
  }

  .btn-secondary svg {
    stroke: var(--color-indigo-600);
  }

  /* ---------- FOOTER ---------- */
  .footer {
    padding: 22px 28px 30px;
    border-top: 1px solid var(--color-gray-200);
    text-align: center;
  }

  .footer .tagline {
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--color-gray-900);
    margin: 0 0 6px;
    line-height: 1.5;
  }

  .footer .site {
    font-size: 0.78rem;
    color: var(--color-gray-400);
    text-decoration: none;
  }
</style>
