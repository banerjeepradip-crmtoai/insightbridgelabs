---
import type { AboutContent } from '../content/about/types';

interface Props {
  enterpriseGap: AboutContent['enterpriseGap'];
}

const { enterpriseGap } = Astro.props;
---

<section class="gap section">
  <div class="container gap-inner">
    <span class="eyebrow">{enterpriseGap.eyebrow}</span>
    <h2>{enterpriseGap.heading}</h2>
    <p class="gap-intro">{enterpriseGap.intro}</p>
    <ul class="gap-list">
      {enterpriseGap.items.map((item) => <li>{item}</li>)}
    </ul>
  </div>
</section>

<style>
  .gap {
    background: var(--color-gray-50);
  }

  .gap-inner {
    max-width: 820px;
  }

  .gap-inner h2 {
    margin: 0 0 20px;
    font-size: clamp(1.5rem, 2.4vw, 1.9rem);
    font-weight: 800;
    color: var(--color-gray-900);
  }

  .gap-intro {
    margin: 0 0 24px;
    color: var(--color-gray-600);
    line-height: 1.8;
  }

  .gap-list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .gap-list li {
    position: relative;
    padding-left: 22px;
    color: var(--color-gray-600);
    line-height: 1.6;
    font-size: 0.95rem;
  }

  .gap-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 8px;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-indigo-600);
  }
</style>
