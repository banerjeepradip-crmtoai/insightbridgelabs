---
import Icon from './Icon.astro';
import type { AboutContent } from '../content/about/types';

interface Props {
  experience: AboutContent['experience'];
}

const { experience } = Astro.props;
---

<section class="experience section">
  <div class="container">
    <div class="experience-heading">
      <div>
        <span class="eyebrow">{experience.eyebrow}</span>
        <h2>{experience.heading}</h2>
      </div>
      <button type="button" class="timeline-toggle" id="experience-toggle" aria-expanded="false" aria-controls="experience-panel">
        <span>Show Professional Experience</span>
        <Icon name="chevron-down" class="toggle-icon" />
      </button>
    </div>

    <div class="timeline-panel is-collapsed" id="experience-panel">
      <ol class="timeline">
        {
          experience.entries.map((entry) => (
            <li class="timeline-item">
              <div class="timeline-marker">
                <Icon name="briefcase" />
              </div>
              <div class="timeline-content">
                <div class="timeline-top">
                  <h3>{entry.role}</h3>
                  <span class="timeline-period">{entry.period}</span>
                </div>
                <p class="timeline-company">{entry.company}</p>
                <ul>
                  {entry.points.map((point) => (
                    <li>{point}</li>
                  ))}
                </ul>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<style>
  .experience-heading {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin: 0 0 40px;
  }

  .experience-heading h2 {
    margin: 0;
    font-size: clamp(1.5rem, 2.4vw, 1.9rem);
    font-weight: 800;
    color: var(--color-gray-900);
  }

  .timeline-toggle {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 18px;
    border-radius: var(--radius-md);
    border: 1.5px solid var(--color-indigo-600);
    background: transparent;
    color: var(--color-indigo-600);
    font-size: 0.9rem;
    font-weight: 600;
    cursor: pointer;
    flex-shrink: 0;
  }

  .timeline-toggle:hover {
    background: var(--color-indigo-600);
    color: #fff;
  }

  .toggle-icon {
    width: 16px;
    height: 16px;
    transition: transform 0.2s ease;
  }

  .timeline-toggle[aria-expanded='true'] .toggle-icon {
    transform: rotate(180deg);
  }

  .timeline-panel.is-collapsed {
    display: none;
  }

  .timeline {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
    max-width: 780px;
  }

  .timeline-item {
    display: flex;
    gap: 20px;
    padding-bottom: 32px;
    position: relative;
  }

  .timeline-item:not(:last-child)::before {
    content: '';
    position: absolute;
    left: 21px;
    top: 44px;
    bottom: 0;
    width: 1.5px;
    background: var(--color-gray-200);
  }

  .timeline-marker {
    flex-shrink: 0;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--color-gray-100);
    color: var(--color-indigo-600);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .timeline-marker .icon {
    width: 20px;
    height: 20px;
  }

  .timeline-top {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 8px 14px;
  }

  .timeline-top h3 {
    margin: 0;
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--color-gray-900);
  }

  .timeline-period {
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--color-indigo-600);
    background: var(--color-gray-100);
    padding: 3px 10px;
    border-radius: 999px;
  }

  .timeline-company {
    margin: 4px 0 12px;
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--color-gray-500);
  }

  .timeline-content ul {
    margin: 0;
    padding-left: 18px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .timeline-content li {
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--color-gray-500);
  }
</style>

<script>
  const toggle = document.getElementById('experience-toggle');
  const panel = document.getElementById('experience-panel');
  const label = toggle?.querySelector('span');

  if (toggle && panel && label) {
    toggle.addEventListener('click', () => {
      const isExpanded = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!isExpanded));
      panel.classList.toggle('is-collapsed', isExpanded);
      label.textContent = isExpanded ? 'Show Professional Experience' : 'Hide Professional Experience';
    });
  }
</script>
