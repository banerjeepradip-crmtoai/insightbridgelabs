---
import type { AboutContent } from '../content/about/types';

interface Props {
  experience: AboutContent['experience'];
}

const { experience } = Astro.props;
---

<section class="experience section">
  <div class="container experience-inner">
    <span class="eyebrow">{experience.eyebrow}</span>
    <h2>{experience.heading}</h2>
    <div class="experience-text">
      {experience.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
    </div>
  </div>
</section>

<style>
  .experience-inner {
    max-width: 820px;
  }

  .experience-inner h2 {
    margin: 0 0 24px;
    font-size: clamp(1.5rem, 2.4vw, 1.9rem);
    font-weight: 800;
    color: var(--color-gray-900);
  }

  .experience-text p {
    color: var(--color-gray-600);
    line-height: 1.8;
    margin: 0 0 18px;
  }

  .experience-text p:last-child {
    margin-bottom: 0;
  }
</style>
