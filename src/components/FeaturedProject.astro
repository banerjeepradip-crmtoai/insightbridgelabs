---
import Icon from './Icon.astro';
import type { AboutContent } from '../content/about/types';

interface Props {
  featuredProjects: AboutContent['featuredProjects'];
}

const { featuredProjects } = Astro.props;
---

<section class="featured-projects section">
  <div class="container">
    <h2>{featuredProjects.heading}</h2>
    <div class="project-list">
      {
        featuredProjects.items.map((project) => (
          <div class="project-card">
            <div class="project-icon">
              <Icon name={project.icon} />
            </div>
            <span class="eyebrow">{project.eyebrow}</span>
            <h3>{project.title}</h3>
            <p>{project.description}</p>
            <div class="tags">
              {project.tags.map((tag) => (
                <span class="tag">{tag}</span>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .featured-projects {
    background: var(--color-gray-50);
  }

  .featured-projects h2 {
    margin: 0 0 32px;
    font-size: clamp(1.5rem, 2.4vw, 1.9rem);
    font-weight: 800;
    color: var(--color-gray-900);
  }

  .project-list {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
  }

  .project-card {
    background: linear-gradient(135deg, var(--color-navy-900) 0%, #26307a 100%);
    border-radius: var(--radius-lg);
    padding: 40px 32px;
    color: #fff;
    display: flex;
    flex-direction: column;
  }

  .project-card p {
    flex: 1;
  }

  @media (max-width: 900px) {
    .project-list {
      grid-template-columns: 1fr;
    }
  }

  .project-icon {
    width: 48px;
    height: 48px;
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.1);
    color: #c3ccff;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 18px;
  }

  .project-card .eyebrow {
    color: #a9b6ff;
  }

  .project-card h3 {
    margin: 8px 0 14px;
    font-size: clamp(1.4rem, 2.2vw, 1.7rem);
    font-weight: 800;
  }

  .project-card p {
    margin: 0 0 22px;
    line-height: 1.75;
    color: #c4c8e6;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .tag {
    font-size: 0.78rem;
    font-weight: 600;
    padding: 5px 12px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.1);
    color: #dde1ff;
  }
</style>
