---
import type { AboutContent } from '../content/about/types';

interface Props {
  impactStats: AboutContent['impactStats'];
}

const { impactStats } = Astro.props;
---

<section class="impact section">
  <div class="container">
    <h2>{impactStats.heading}</h2>
    <div class="impact-grid">
      {
        impactStats.items.map((stat) => (
          <div class="impact-card">
            <p class="impact-value">{stat.value}</p>
            <p class="impact-label">{stat.label}</p>
            <span class="impact-category">{stat.category}</span>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .impact {
    background: var(--color-gray-50);
  }

  .impact h2 {
    margin: 0 0 40px;
    font-size: clamp(1.5rem, 2.4vw, 1.9rem);
    font-weight: 800;
    color: var(--color-gray-900);
  }

  .impact-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .impact-card {
    background: #fff;
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-gray-100);
    padding: 28px 24px;
  }

  .impact-value {
    margin: 0 0 6px;
    font-size: 2rem;
    font-weight: 800;
    color: var(--color-indigo-600);
  }

  .impact-label {
    margin: 0 0 10px;
    font-size: 0.95rem;
    color: var(--color-gray-600);
    line-height: 1.5;
  }

  .impact-category {
    display: block;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-gray-400);
  }

  @media (max-width: 900px) {
    .impact-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 560px) {
    .impact-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
