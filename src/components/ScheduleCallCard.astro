---
import Icon from './Icon.astro';
import { getUiStrings } from '../i18n/ui';
import type { ContactContent } from '../content/contact/types';

interface Props {
  schedule: ContactContent['schedule'];
  lang: string;
}

const { schedule, lang } = Astro.props;
const t = getUiStrings(lang);
---

<section class="schedule section">
  <div class="container">
    <div class="schedule-card">
      <div class="schedule-header">
        <h2>{schedule.heading}</h2>
        <p>{schedule.body}</p>
        <a href={schedule.href} class="btn btn-outline-dark" target="_blank" rel="noopener noreferrer">
          {schedule.buttonLabel}
          <Icon name="external-link" class="btn-icon" />
        </a>
      </div>
      <div class="schedule-embed">
        <iframe src={schedule.embedSrc} title={t.bookACall} loading="eager" />
      </div>
    </div>
  </div>
</section>

<style>
  .schedule {
    background: var(--color-gray-50);
  }

  .schedule-card {
    background: #fff;
    border: 1px solid var(--color-gray-100);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-card);
    overflow: hidden;
  }

  .schedule-header {
    padding: 32px 32px 8px;
  }

  .schedule-header h2 {
    margin: 0 0 10px;
    font-size: 1.2rem;
    font-weight: 800;
    color: var(--color-gray-900);
  }

  .schedule-header p {
    margin: 0 0 20px;
    font-size: 0.92rem;
    line-height: 1.65;
    color: var(--color-gray-500);
    max-width: 640px;
  }

  .btn-icon {
    width: 15px;
    height: 15px;
  }

  .schedule-embed {
    border-top: 1px solid var(--color-gray-100);
  }

  .schedule-embed iframe {
    display: block;
    width: 100%;
    height: 650px;
    border: 0;
  }

  @media (max-width: 700px) {
    .schedule-header {
      padding: 26px 22px 8px;
    }

    .schedule-embed iframe {
      height: 550px;
    }
  }
</style>
