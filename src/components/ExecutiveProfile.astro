---
import type { AboutContent } from '../content/about/types';

interface Props {
  bio: AboutContent['bio'];
}

const { bio } = Astro.props;
---

<section class="profile section">
  <div class="container profile-inner">
    <h2>{bio.heading}</h2>
    <div class="profile-text">
      {bio.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
    </div>
    <div class="pillar-grid">
      {
        bio.pillars.map((pillar) => (
          <div class="pillar-card">
            <span class="pillar-title">{pillar.title}</span>
            <p>{pillar.description}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .profile-inner {
    max-width: 900px;
  }

  .profile-inner h2 {
    margin: 0 0 24px;
    font-size: clamp(1.5rem, 2.4vw, 1.9rem);
    font-weight: 800;
    color: var(--color-gray-900);
  }

  .profile-text p {
    color: var(--color-gray-600);
    line-height: 1.8;
    margin: 0 0 18px;
  }

  .profile-text p:last-child {
    margin-bottom: 0;
  }

  .pillar-grid {
    margin-top: 40px;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .pillar-card {
    background: var(--color-gray-50);
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-gray-100);
    padding: 24px;
  }

  .pillar-title {
    display: block;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-indigo-600);
    margin-bottom: 10px;
  }

  .pillar-card p {
    margin: 0;
    font-size: 0.92rem;
    line-height: 1.6;
    color: var(--color-gray-600);
  }

  @media (max-width: 700px) {
    .pillar-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
