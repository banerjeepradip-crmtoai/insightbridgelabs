---
import type { AboutContent } from '../content/about/types';

interface Props {
  bio: AboutContent['bio'];
}

const { bio } = Astro.props;
---

<section class="profile section">
  <div class="container profile-inner">
    <h2>{bio.heading}</h2>
    <div class="profile-text">
      {bio.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
    </div>
  </div>
</section>

<style>
  .profile-inner {
    max-width: 820px;
  }

  .profile-inner h2 {
    margin: 0 0 24px;
    font-size: clamp(1.5rem, 2.4vw, 1.9rem);
    font-weight: 800;
    color: var(--color-gray-900);
  }

  .profile-text p {
    color: var(--color-gray-600);
    line-height: 1.8;
    margin: 0 0 18px;
  }

  .profile-text p:last-child {
    margin-bottom: 0;
  }
</style>
