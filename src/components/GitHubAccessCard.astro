---
import Icon from './Icon.astro';
import type { ContactContent } from '../content/contact/types';

interface Props {
  github: ContactContent['github'];
}

const { github } = Astro.props;
---

<section class="github-access section">
  <div class="container">
    <div class="github-card">
      <div class="github-icon">
        <Icon name="code" />
      </div>
      <div>
        <h2>{github.heading}</h2>
        <p>{github.body}</p>
        <a href={github.href} class="btn btn-outline-dark" target="_blank" rel="noopener noreferrer">
          {github.buttonLabel}
          <Icon name="external-link" class="btn-icon" />
        </a>
      </div>
    </div>
  </div>
</section>

<style>

  .github-card {
    display: flex;
    gap: 24px;
    align-items: flex-start;
    background: #fff;
    border: 1px solid var(--color-gray-100);
    border-radius: var(--radius-lg);
    padding: 32px;
    max-width: 780px;
  }

  .github-icon {
    flex-shrink: 0;
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background: var(--color-gray-900);
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .github-card h2 {
    margin: 0 0 10px;
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--color-gray-900);
  }

  .github-card p {
    margin: 0 0 20px;
    font-size: 0.92rem;
    line-height: 1.65;
    color: var(--color-gray-500);
  }

  .btn-icon {
    width: 15px;
    height: 15px;
  }

  @media (max-width: 600px) {
    .github-card {
      flex-direction: column;
      padding: 26px 22px;
    }
  }
</style>
