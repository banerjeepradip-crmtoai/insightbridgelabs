---
import type { AboutContent } from '../content/about/types';

interface Props {
  leadershipDomains: AboutContent['leadershipDomains'];
}

const { leadershipDomains } = Astro.props;
---

<section class="leadership section">
  <div class="container">
    <h2>{leadershipDomains.heading}</h2>
    <div class="leadership-grid">
      {
        leadershipDomains.groups.map((group) => (
          <div class="leadership-group">
            <h3>{group.title}</h3>
            <p>{group.items.join(' • ')}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .leadership {
    background: var(--color-gray-50);
  }

  .leadership h2 {
    margin: 0 0 32px;
    font-size: clamp(1.5rem, 2.4vw, 1.9rem);
    font-weight: 800;
    color: var(--color-gray-900);
  }

  .leadership-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 28px 40px;
  }

  .leadership-group h3 {
    margin: 0 0 10px;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-indigo-600);
  }

  .leadership-group p {
    margin: 0;
    font-size: 0.92rem;
    line-height: 1.7;
    color: var(--color-gray-600);
  }

  @media (max-width: 700px) {
    .leadership-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
