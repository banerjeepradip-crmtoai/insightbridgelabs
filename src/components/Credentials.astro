---
import Icon from './Icon.astro';
import type { AboutContent } from '../content/about/types';

interface Props {
  credentials: AboutContent['credentials'];
  quickFacts: AboutContent['quickFacts'];
}

const { credentials, quickFacts } = Astro.props;
---

<section class="credentials section">
  <div class="container credentials-grid">
    <div class="credentials-col">
      <h3>{credentials.certificationsHeading}</h3>
      <ul class="check-list">
        {
          credentials.certifications.map((item) => (
            <li>
              <Icon name="check" class="check-icon" />
              <span>{item}</span>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="credentials-col quick-facts">
      <h3>{quickFacts.heading}</h3>
      <ul class="fact-list">
        <li>
          <Icon name="location" class="check-icon" />
          <span>{quickFacts.location}</span>
        </li>
        <li>
          <Icon name="globe" class="check-icon" />
          <span>{quickFacts.languages}</span>
        </li>
        {
          quickFacts.memberships.map((membership) => (
            <li>
              <Icon name="people" class="check-icon" />
              <span>{membership}</span>
            </li>
          ))
        }
        <li>
          <Icon name="briefcase" class="check-icon" />
          <span>{quickFacts.workEligibility}</span>
        </li>
      </ul>
    </div>
  </div>
</section>

<style>
  .credentials {
    background: var(--color-gray-50);
  }

  .credentials-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 40px;
  }

  .credentials-col h3 {
    margin: 0 0 18px;
    font-size: 0.95rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    color: var(--color-gray-900);
  }

  .check-list,
  .fact-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .check-list li,
  .fact-list li {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-size: 0.9rem;
    color: var(--color-gray-600);
    line-height: 1.5;
  }

  .check-icon {
    width: 16px;
    height: 16px;
    color: var(--color-indigo-600);
    flex-shrink: 0;
    margin-top: 2px;
  }

  @media (max-width: 900px) {
    .credentials-grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }
  }
</style>
