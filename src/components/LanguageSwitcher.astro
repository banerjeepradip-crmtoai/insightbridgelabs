---
import Icon from './Icon.astro';
import { languages } from '../i18n/languages';

interface Props {
  currentLang: string;
}

const { currentLang } = Astro.props;
const current = languages.find((l) => l.code === currentLang) ?? languages[0];
---

<div class="lang-switcher">
  <button type="button" class="lang-trigger" aria-haspopup="true" aria-expanded="false" id="lang-trigger">
    <Icon name="globe" class="lang-globe" />
    <span>{current.code.toUpperCase()}</span>
    <Icon name="chevron-down" class="lang-chevron" />
  </button>
  <ul class="lang-menu" id="lang-menu" role="menu">
    {
      languages.map((lang) => (
        <li role="none">
          {lang.ready ? (
            <a
              role="menuitem"
              href={lang.code === 'en' ? '/' : `/${lang.code}/`}
              class:list={['lang-option', { 'is-active': lang.code === currentLang }]}
            >
              <span>{lang.nativeLabel}</span>
            </a>
          ) : (
            <span role="menuitem" aria-disabled="true" class="lang-option is-disabled">
              <span>{lang.nativeLabel}</span>
              <em>Soon</em>
            </span>
          )}
        </li>
      ))
    }
  </ul>
</div>

<style>
  .lang-switcher {
    position: relative;
  }

  .lang-trigger {
    display: flex;
    align-items: center;
    gap: 6px;
    background: transparent;
    border: 1.5px solid var(--color-gray-200);
    border-radius: var(--radius-md);
    padding: 8px 12px;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-gray-600);
    cursor: pointer;
  }

  .lang-trigger:hover {
    border-color: var(--color-indigo-600);
    color: var(--color-indigo-600);
  }

  .lang-globe,
  .lang-chevron {
    width: 16px;
    height: 16px;
  }

  .lang-menu {
    position: absolute;
    top: calc(100% + 8px);
    right: 0;
    list-style: none;
    margin: 0;
    padding: 6px;
    min-width: 170px;
    background: #fff;
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-card);
    border: 1px solid var(--color-gray-100);
    opacity: 0;
    visibility: hidden;
    transform: translateY(4px);
    transition: opacity 0.15s ease, transform 0.15s ease, visibility 0.15s;
    z-index: 60;
  }

  .lang-switcher.is-open .lang-menu {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .lang-option {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding: 9px 10px;
    border-radius: 8px;
    font-size: 0.9rem;
    color: var(--color-gray-900);
  }

  a.lang-option:hover {
    background: var(--color-gray-50);
    color: var(--color-indigo-600);
  }

  .lang-option.is-active {
    color: var(--color-indigo-600);
    font-weight: 600;
  }

  .lang-option.is-disabled {
    color: var(--color-gray-400);
    cursor: default;
  }

  .lang-option.is-disabled em {
    font-style: normal;
    font-size: 0.7rem;
    background: var(--color-gray-100);
    padding: 2px 6px;
    border-radius: 999px;
  }
</style>

<script>
  const switcher = document.querySelector('.lang-switcher');
  const trigger = document.getElementById('lang-trigger');

  if (switcher && trigger) {
    trigger.addEventListener('click', (event) => {
      event.stopPropagation();
      const isOpen = switcher.classList.toggle('is-open');
      trigger.setAttribute('aria-expanded', String(isOpen));
    });

    document.addEventListener('click', () => {
      switcher.classList.remove('is-open');
      trigger.setAttribute('aria-expanded', 'false');
    });
  }
</script>
