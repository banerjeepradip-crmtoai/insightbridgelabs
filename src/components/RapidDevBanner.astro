---
import Icon from './Icon.astro';
import type { HomeContent } from '../content/home/types';

interface Props {
  rapidDev: HomeContent['rapidDev'];
}

const { rapidDev } = Astro.props;
---

<section class="rapid-dev">
  <div class="container rapid-dev-inner">
    <div class="rapid-dev-copy">
      <span class="rapid-dev-eyebrow">
        <Icon name="code" />
        {rapidDev.eyebrow}
      </span>
      <h2>{rapidDev.heading}</h2>
      <p>{rapidDev.body}</p>
      <div class="rapid-dev-actions">
        <a href={rapidDev.primaryCtaHref} class="btn btn-primary">{rapidDev.primaryCta}</a>
        <a href={rapidDev.secondaryCtaHref} class="btn btn-outline-light">{rapidDev.secondaryCta}</a>
      </div>
    </div>

    <div class="rapid-dev-art" aria-hidden="true">
      <svg viewBox="0 0 520 460" class="rapid-dev-svg">
        <defs>
          <pattern id="rd-dots" width="24" height="24" patternUnits="userSpaceOnUse">
            <circle cx="2" cy="2" r="1.4" fill="rgba(255,255,255,0.16)" />
          </pattern>
          <radialGradient id="rd-halo" cx="50%" cy="50%" r="50%">
            <stop offset="0%" stop-color="#9b7cf6" stop-opacity="0.55" />
            <stop offset="100%" stop-color="#9b7cf6" stop-opacity="0" />
          </radialGradient>
          <linearGradient id="rd-core" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#6d7cf7" />
            <stop offset="100%" stop-color="#9b7cf5" />
          </linearGradient>
        </defs>

        <rect x="10" y="10" width="500" height="440" rx="28" fill="rgba(255,255,255,0.04)" stroke="rgba(255,255,255,0.14)" stroke-width="1.5" />
        <rect x="10" y="10" width="500" height="440" rx="28" fill="url(#rd-dots)" opacity="0.6" />

        <circle cx="46" cy="46" r="5" fill="rgba(255,255,255,0.35)" />
        <circle cx="66" cy="46" r="5" fill="rgba(255,255,255,0.35)" />
        <circle cx="86" cy="46" r="5" fill="rgba(255,255,255,0.35)" />
        <line x1="30" y1="74" x2="490" y2="74" stroke="rgba(255,255,255,0.12)" stroke-width="1" />

        <g stroke="rgba(255,255,255,0.3)" stroke-width="1.6">
          <line x1="260" y1="230" x2="260" y2="80" />
          <line x1="260" y1="230" x2="410" y2="230" />
          <line x1="260" y1="230" x2="260" y2="380" />
          <line x1="260" y1="230" x2="110" y2="230" />
        </g>

        <g class="rd-orbit" style="transform-origin: 260px 230px;">
          <circle cx="260" cy="230" r="58" fill="none" stroke="rgba(255,255,255,0.25)" stroke-width="1.2" stroke-dasharray="3 7" />
        </g>

        <circle cx="260" cy="230" r="64" fill="url(#rd-halo)" />
        <circle cx="260" cy="230" r="42" fill="url(#rd-core)" stroke="rgba(255,255,255,0.4)" stroke-width="1.5" />
        <path d="M260 208 L264 226 L282 230 L264 234 L260 252 L256 234 L238 230 L256 226 Z" fill="#fff" opacity="0.95" />

        <rect x="219" y="307" width="82" height="22" rx="8" fill="rgba(8,10,32,0.65)" stroke="rgba(255,255,255,0.12)" stroke-width="1" />
        <text x="260" y="322" text-anchor="middle" font-size="12" font-weight="700" fill="#f3f0ff" letter-spacing="0.02em">{rapidDev.diagram.hub}</text>

        {
          [
            { x: 260, y: 80, label: rapidDev.diagram.code, path: '<path d="M9 8l-4 4 4 4" /><path d="M15 8l4 4-4 4" /><path d="M13 5l-2 14" />' },
            { x: 410, y: 230, label: rapidDev.diagram.cicd, path: '<path d="M7 17a4 4 0 01-.5-7.97A5 5 0 0116.5 7H17a3.5 3.5 0 010 7h-.5" /><path d="M12 21v-7" /><path d="M9 16.5L12 13.5 15 16.5" />' },
            { x: 260, y: 380, label: rapidDev.diagram.enable, path: '<circle cx="9" cy="8" r="3" /><path d="M3 20a6 6 0 0112 0" /><circle cx="17" cy="9" r="2.5" /><path d="M14.5 20a5 5 0 016.5-4.8" />' },
            { x: 110, y: 230, label: rapidDev.diagram.agents, path: '<path d="M9 4a2.5 2.5 0 00-2.5 2.5v.6A2.5 2.5 0 004 9.5a2.5 2.5 0 001 4.7v.8A2.5 2.5 0 007.5 17.5H9V4z" /><path d="M15 4a2.5 2.5 0 012.5 2.5v.6A2.5 2.5 0 0120 9.5a2.5 2.5 0 01-1 4.7v.8a2.5 2.5 0 01-2.5 2.5H15V4z" /><path d="M9 4v13.5M15 4v13.5" />' },
          ].map((node) => (
            <>
              <circle cx={node.x} cy={node.y} r="26" fill="url(#rd-halo)" opacity="0.35" />
              <circle cx={node.x} cy={node.y} r="22" fill="rgba(255,255,255,0.1)" stroke="rgba(255,255,255,0.35)" stroke-width="1.5" />
              <g
                transform={`translate(${node.x - 11} ${node.y - 11}) scale(0.92)`}
                fill="none"
                stroke="#ffffff"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
                set:html={node.path}
              />
              <rect x={node.x - 41} y={node.y + 29} width="82" height="22" rx="8" fill="rgba(8,10,32,0.65)" stroke="rgba(255,255,255,0.12)" stroke-width="1" />
              <text x={node.x} y={node.y + 44} text-anchor="middle" font-size="12" font-weight="600" fill="#d9dcf5" letter-spacing="0.02em">{node.label}</text>
            </>
          ))
        }

        <circle cx="452" cy="96" r="3" fill="rgba(255,255,255,0.4)" />
        <circle cx="76" cy="352" r="2.5" fill="rgba(255,255,255,0.35)" />
        <circle cx="430" cy="372" r="2" fill="rgba(255,255,255,0.3)" />
      </svg>
    </div>
  </div>
</section>

<style>
  .rapid-dev {
    position: relative;
    background: var(--color-navy-950);
    background-image: radial-gradient(circle at 12% 20%, rgba(109, 124, 247, 0.35), transparent 45%),
      radial-gradient(circle at 88% 80%, rgba(155, 124, 245, 0.3), transparent 50%);
    color: #fff;
    overflow: hidden;
  }

  .rapid-dev-inner {
    padding: 72px 24px;
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: 40px;
    align-items: center;
  }

  .rapid-dev-copy {
    max-width: 560px;
  }

  .rapid-dev-art {
    width: 100%;
    max-width: 460px;
    margin: 0 auto;
  }

  .rapid-dev-svg {
    width: 100%;
    height: auto;
    display: block;
  }

  .rd-orbit {
    animation: rd-spin 22s linear infinite;
  }

  @keyframes rd-spin {
    to {
      transform: rotate(360deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .rd-orbit {
      animation: none;
    }
  }

  @media (max-width: 900px) {
    .rapid-dev-inner {
      grid-template-columns: 1fr;
    }

    .rapid-dev-art {
      max-width: 340px;
      order: -1;
    }
  }

  .rapid-dev-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #c4c8e6;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.16);
    padding: 6px 14px;
    border-radius: 999px;
    margin-bottom: 20px;
  }

  .rapid-dev-eyebrow .icon {
    width: 15px;
    height: 15px;
  }

  .rapid-dev-copy h2 {
    margin: 0 0 16px;
    font-size: clamp(1.7rem, 3.2vw, 2.4rem);
    font-weight: 800;
    line-height: 1.2;
    background: var(--color-accent-gradient);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .rapid-dev-copy p {
    margin: 0 0 30px;
    max-width: 560px;
    color: #c4c8e6;
    line-height: 1.7;
    font-size: 1.02rem;
  }

  .rapid-dev-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
  }
</style>
