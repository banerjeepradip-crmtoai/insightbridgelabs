---
import Icon from './Icon.astro';
import type { HomeContent } from '../content/home/types';

interface Props {
  about: HomeContent['about'];
}

const { about } = Astro.props;
---

<section class="about section">
  <div class="container about-grid">
    <div class="about-copy">
      <span class="eyebrow">{about.eyebrow}</span>
      <h2>{about.heading}</h2>
      <p>{about.body}</p>
      <a href="/about" class="btn btn-primary">{about.cta}</a>
    </div>

    <div class="about-cards">
      {
        about.cards.map((card) => (
          <a href={card.href} class="service-card">
            <div class:list={['card-media', `card-media--${card.image}`]}>
              <span class="card-badge">
                <Icon name={card.icon} />
              </span>
            </div>
            <div class="card-body">
              <h3>{card.title}</h3>
              <p>{card.description}</p>
              <span class="card-link">
                Learn More <Icon name="arrow-right" />
              </span>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  .about-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.6fr);
    gap: 56px;
    align-items: start;
  }

  .about-copy h2 {
    margin: 0 0 18px;
    font-size: clamp(1.6rem, 2.6vw, 2.1rem);
    font-weight: 800;
    line-height: 1.25;
    color: var(--color-gray-900);
  }

  .about-copy p {
    color: var(--color-gray-500);
    line-height: 1.75;
    margin: 0 0 28px;
  }

  .about-cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .service-card {
    display: block;
    background: #fff;
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-card);
    border: 1px solid var(--color-gray-100);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .service-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 18px 36px -14px rgba(20, 23, 43, 0.28);
  }

  .card-media {
    position: relative;
    height: 150px;
    background: linear-gradient(135deg, var(--color-navy-900) 0%, #26307a 100%);
  }

  .card-media--governance {
    background: linear-gradient(135deg, #0d1440 0%, #3646a8 100%);
  }

  .card-media--consulting {
    background: linear-gradient(135deg, #131a45 0%, #4b3d9e 100%);
  }

  .card-media--solutions {
    background: linear-gradient(135deg, #0b1130 0%, #2d5aa8 100%);
  }

  .card-badge {
    position: absolute;
    left: 20px;
    bottom: -20px;
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background: #fff;
    color: var(--color-indigo-600);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: var(--shadow-card);
  }

  .card-body {
    padding: 32px 20px 22px;
  }

  .card-body h3 {
    margin: 0 0 10px;
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--color-gray-900);
  }

  .card-body p {
    margin: 0 0 16px;
    font-size: 0.88rem;
    line-height: 1.6;
    color: var(--color-gray-500);
  }

  .card-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--color-indigo-600);
  }

  .card-link .icon {
    width: 15px;
    height: 15px;
    transition: transform 0.2s ease;
  }

  .service-card:hover .card-link .icon {
    transform: translateX(3px);
  }

  @media (max-width: 1080px) {
    .about-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 760px) {
    .about-cards {
      grid-template-columns: 1fr;
    }
  }
</style>
