---
import BridgeMark from './BridgeMark.astro';
import type { HomeContent } from '../content/home/types';

interface Props {
  footer: HomeContent['footer'];
}

const { footer } = Astro.props;
---

<footer class="site-footer">
  <div class="container footer-inner">
    <div class="footer-brand">
      <a href="/" class="brand">
        <BridgeMark class="brand-mark" />
        <span class="brand-text">
          <span class="brand-main">InsightBridge</span>
          <span class="brand-sub">LABS</span>
        </span>
      </a>
      <p>{footer.tagline}</p>
    </div>

    <div class="footer-columns">
      {
        footer.columns.map((column) => (
          <div class="footer-column">
            <h3>{column.heading}</h3>
            <ul>
              {column.links.map((link) => (
                <li>
                  <a href={link.href}>{link.label}</a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>

  <div class="footer-bottom">
    <div class="container">
      <p>{footer.copyright}</p>
      <p>{footer.orgNumber}</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-navy-950);
    color: var(--color-gray-400);
  }

  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    gap: 48px;
    justify-content: space-between;
    padding: 64px 24px 48px;
  }

  .footer-brand {
    max-width: 320px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--color-purple-400);
  }

  .brand-text {
    display: flex;
    flex-direction: column;
    line-height: 1.05;
  }

  .footer-brand .brand-main {
    color: #fff;
  }

  .footer-brand .brand-main::first-letter,
  .footer-brand .brand-sub {
    color: var(--color-purple-400);
  }

  .footer-brand p {
    margin-top: 14px;
    font-size: 0.92rem;
    line-height: 1.6;
  }

  .footer-columns {
    display: flex;
    flex-wrap: wrap;
    gap: 48px;
  }

  .footer-column h3 {
    margin: 0 0 16px;
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #fff;
  }

  .footer-column ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .footer-column a {
    font-size: 0.9rem;
  }

  .footer-column a:hover {
    color: #fff;
  }

  .footer-bottom {
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    padding: 20px 0;
  }

  .footer-bottom p {
    margin: 0;
    font-size: 0.82rem;
  }

  .footer-bottom p + p {
    margin-top: 4px;
  }
</style>
