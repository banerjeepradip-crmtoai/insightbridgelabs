---
interface Props {
  heading: string;
  body: string;
  primaryLabel: string;
  primaryHref: string;
  secondaryLabel: string;
  secondaryHref: string;
}

const { heading, body, primaryLabel, primaryHref, secondaryLabel, secondaryHref } = Astro.props;
---

<section class="cta-band">
  <div class="container cta-inner">
    <div>
      <h2>{heading}</h2>
      <p>{body}</p>
    </div>
    <div class="cta-actions">
      <a href={primaryHref} class="btn btn-primary">{primaryLabel}</a>
      <a href={secondaryHref} class="btn btn-outline-light">{secondaryLabel}</a>
    </div>
  </div>
</section>

<style>
  .cta-band {
    background: var(--color-navy-950);
    color: #fff;
  }

  .cta-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 28px;
    padding: 64px 24px;
  }

  .cta-inner h2 {
    margin: 0 0 10px;
    font-size: clamp(1.4rem, 2.4vw, 1.8rem);
    font-weight: 800;
  }

  .cta-inner p {
    margin: 0;
    max-width: 520px;
    color: #c4c8e6;
    line-height: 1.6;
  }

  .cta-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    flex-shrink: 0;
  }
</style>
